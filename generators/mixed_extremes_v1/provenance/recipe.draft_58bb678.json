  "common_rules": {
    "randomness": "One random.Random(seed) per case, shuffle physical pid permutation for each operator in ascending op order; no rejection reseeding.",
    "build": "Ascending operator, then ascending physical pid, INSERT chunks <=1048576, then exactly one SWITCH. For prelude cases emit specified PROBEs to just-switched operator before building the next.",
    "role_mapping": "All logical pid references pass through that operator permutation; byte layouts are permuted the same way.",
    "clocks": "Global probe ordinal and per-op probe ordinal are absolute, include build-overlap preludes, never reset at a phase/block boundary.",
    "key": "pid + P*((seed + 104729*absolute_operation_ordinal) % (((1000000000-(P-1))//P)+1)); canonical semantic signature reduces key modulo P.",
    "main_schedule": "Except special reuse/next-bait/boundary families, operator is main_operator_rate_cycle[absolute global probe ordinal % cycle length].",
    "hot_cold": "Within each local period first hot_hits_per_period entries cycle listed hot ids; remaining entries cycle cold ids. Both use absolute local probe ordinal modulo eligible-list size.",
    "reuse_anchor": "Anchor at global ordinal0, then at cumulative frozen gap-cycle distances; other requests are fillers. Truncated final gap is retained without resampling.",
    "phase": "phase=(global ordinal + operator phase offset)//global_phase_length % 2; select A for0/B for1, swap if reverse_A_B_start.",
    "keys_are_not_families": "Raw, operation and modulo-P stream hashes must all be unique and differ from all80 existing inputs; a collision fails, never chooses a new seed.",
    "headers": "K operator declarations in ascending op_id; counts computed from emitted stream, N counts INSERT+SWITCH+PROBE.",
    "metadata": "O(KP) counts/layout plus fixed parameters, measured bytes/sha/audit; no per-operation positions or copied full stream.",
    "timing": "Monotonic generation deadline60s includes construction/write and independent public audit of all16. Retain partial outputs on failure; no automatic solver or reseeding."
  },
