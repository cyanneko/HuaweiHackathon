    "credit_fraction": 0.25,
    "credit_formula": "max(1us, floor(max(0,qsize-(M-U+f1-sizep))/2^shift)/W)",
    "local_proof": {
      "state": "Current PROBE target p is being loaded. The one known next operation is PROBE q, q is initially resident, q differs from p, and size(p)+size(q)<=M. The unprotected SPILL plan a evicts q; f1=written(a). The alternative protects q and writes f2. Plans are valid and contain only SPILL actions.",
      "deficit": "free_after_p=M-U+f1-size(p); d=max(0,size(q)-free_after_p)",
      "unprotected_lower_bound": "After a and LOAD(p), q is on disk. Before q can be served it must be loaded, costing size(q)/R whether this occurs in the intervening periodic callback or on miss. With no data-changing operation between these consecutive probes, capacity forces at least d additional SPILL bytes. Additional loads can only increase the required writes.",
      "protected_cost": "Protect-q plan writes f2 and retains q while LOAD(p) completes. The existing periodic PROBE path performs no IO for an already resident q. Thus, through service of q, it needs neither a q read nor another spill.",
      "common_costs": "Initial p read and already incurred p miss penalty are common and cancel.",
      "local_dominance": "(f2-f1)/W <= size(q)/R+d/W implies no greater IO for this fixed p,q service prefix.",
      "credit": "max(1us, floor(d/2^shift)/W), shift in {0,1,2}",
      "legacy_boundary": "Keep the old size(q)/R+1us acceptance region. A decision newly accepted by the expanded comparison necessarily has credit>1us; its extra write time is then <=size(q)/R+floor(d/2^shift)/W<=size(q)/R+d/W. The inherited +1us region itself has no general IO-dominance proof.",
      "cut": "After service of the known next q, BEFORE the periodic callback belonging to q.",
      "not_claimed": "No claim that q must miss: periodic preloading may avoid its miss penalty. No bound on callback D, unknown operations after q, or full Score. Real-arithmetic certificate only; floating comparisons are not machine-certified.",
      "legal_information": "Uses only current SystemState, one legal next_op and the two already computed plans.",
      "integer_domain": "For valid plans f1,f2<=U<=M, partition sizes<=M<=4GiB. Deficit arithmetic and f2-f1 are safely int64; max(0,...) precedes the right shift."
    },
